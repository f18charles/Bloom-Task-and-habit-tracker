{
  "expo": {
    "name": "Bloom Productivity",
    "slug": "bloom-productivity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Bloom to use Face ID to securely unlock and sign in to your workspace."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bloom.productivity",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Bloom to use Face ID to securely unlock and sign in to your workspace."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10B981"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.bloom.productivity"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://bloom-iota-eight-40.vercel.app",
      "eas": {
        "projectId": "3fae49b0-e320-4678-b2e5-1d67bce34a67"
      }
    },
    "owner": "fco1000"
  }
}
